# Copie para a1.env e preencha. Não compartilhe o a1.env preenchido.

# OCID do compartimento (para a raiz, use o OCID da tenancy)
COMPARTMENT_ID=ocid1.tenancy.oc1..xxxxxxxx

# Nome do AD da região home: oci iam availability-domain list --query 'data[].name'
AVAILABILITY_DOMAIN=xxxx:SA-SAOPAULO-1-AD-1

# Subnet PÚBLICA (com Internet Gateway): oci network subnet list --compartment-id <OCID>
SUBNET_ID=ocid1.subnet.oc1.xxxxxxxx

# Imagem ARM (aarch64) da região: veja o comando no LEIA-ME
IMAGE_ID=ocid1.image.oc1.xxxxxxxx

# Chave PÚBLICA SSH que vai entrar na instância
SSH_PUB_KEY=/home/ubuntu/criar-a1/chave.pub

# Opcionais
NOME=MINHA_A1
DISCO_GB=50
INTERVALO=300
